def get_base_dir():
    if getattr(sys, "frozen", False):
        return Path(sys.executable).parent
    return Path(__file__).resolve().parent


BASE_DIR        = get_base_dir()
API_CONFIG_PATH = BASE_DIR / "config" / "api_keys.json"
PROMPT_PATH     = BASE_DIR / "core" / "prompt.txt"
LIVE_MODEL          = "models/gemini-2.5-flash-native-audio-preview-12-2025"
FORMAT              = pyaudio.paInt16
CHANNELS            = 1
SEND_SAMPLE_RATE    = 16000
RECEIVE_SAMPLE_RATE = 24000
CHUNK_SIZE          = 1024

pya = pyaudio.PyAudio()


def _get_api_key() -> str:
    with open(API_CONFIG_PATH, "r", encoding="utf-8") as f:
        return json.load(f)["gemini_api_key"]


def handle_memory_commands(user_input):
    from memory.memory_manager import save_fact, forget_fact, save_command, forget_command, get_all_commands
    text = user_input.strip()

    # Save a fact: "remember that my name is Aryan"
    if text.lower().startswith("remember that "):
        fact = text[14:]  # strip "remember that "
        # Try to split on " is "
        if " is " in fact:
            key, value = fact.split(" is ", 1)
            save_fact(key.strip(), value.strip())
            return f"Got it! I'll remember that {key.strip()} is {value.strip()}."

    # Save a command: "when I say 'open notes' do notepad"
    if "when i say" in text.lower() and " do " in text.lower():
        try:
            parts = text.lower().split("when i say")[-1].split(" do ")
            trigger = parts[0].strip().strip("'\"")
            action = parts[1].strip()
            save_command(trigger, action)
            return f"Done! I'll remember '{trigger}' means: {action}"
        except Exception:
            pass

    # Forget: "forget my name" or "forget open yt"
    if text.lower().startswith("forget "):
        key = text[7:].strip().lower()
        # Check if it's a command first
        commands = get_all_commands()
        if key in commands:
            forget_command(key)
            return f"Okay, I've forgotten the command '{key}'."
        else:
            forget_fact(key)
            return f"Okay, I've forgotten '{key}'."

    return None  # not a memory command, pass to Gemini


def _load_system_prompt() -> str:
    try:
        return PROMPT_PATH.read_text(encoding="utf-8")
    except Exception:
        return (
            "You are LESTER, Tony Stark's AI assistant. "
            "Be concise, direct, and always use the provided tools to complete tasks. "
            "Never simulate or guess results — always call the appropriate tool."
        )

_last_memory_input = ""


def _update_memory_async(user_text: str, lester_text: str) -> None:
    global _last_memory_input

    user_text   = (user_text   or "").strip()
    lester_text = (lester_text or "").strip()

    if len(user_text) < 5 or user_text == _last_memory_input:
        return
    _last_memory_input = user_text

    try:
        api_key = _get_api_key()
        if not should_extract_memory(user_text, lester_text, api_key):
            return
        data = extract_memory(user_text, lester_text, api_key)
        if data:
            update_memory(data)
            print(f"[Memory] ✅ {list(data.keys())}")
    except Exception as e:
        if "429" not in str(e):
            print(f"[Memory] ⚠️ {e}")

