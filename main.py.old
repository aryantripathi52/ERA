class LesterLocal:

    def __init__(self, ui: LesterUI):
        self.ui           = ui
        self.voice        = VoiceEngine()
        self.is_running   = False
        self.ui.on_text_command = self._on_text_command

    def _on_text_command(self, text: str):
        # Handle manual text input from UI
        threading.Thread(target=self._process_input, args=(text,), daemon=True).start()

    def speak(self, text: str):
        self.ui.set_state("SPEAKING")
        self.voice.speak(text)
        self.ui.set_state("LISTENING")

    def _process_input(self, text: str):
        if not text: return
        self.ui.write_log(f"You: {text}")

        # 1. Check memory commands
        memory_response = handle_memory_commands(text)
        if memory_response:
            self.ui.write_log(f"Lester: {memory_response}")
            self.speak(memory_response)
            return

        # 2. Check custom commands
        from memory.memory_manager import get_command
        command_action = get_command(text.strip())
        if command_action:
            self.ui.write_log(f"Lester: Running: {command_action}")
            text = command_action

        # 3. Generate response with Ollama
        self.ui.set_state("THINKING")
        
        # Build context
        memory = load_memory()
        mem_str = format_memory_for_prompt(memory)
        facts_cmds = build_system_context()
        sys_prompt = _load_system_prompt()
        
        from datetime import datetime
        time_ctx = f"Current time: {datetime.now().strftime('%H:%M')}\n"
        
        full_system = f"{time_ctx}\n{mem_str}\n{facts_cmds}\n{sys_prompt}"

        try:
            response = ollama.chat(
                model='llama3',
                messages=[
                    {'role': 'system', 'content': full_system},
                    {'role': 'user', 'content': text}
                ]
            )
            ans = response['message']['content'].strip()
            self.ui.write_log(f"Lester: {ans}")
            self.speak(ans)
            
            # Async memory extraction
            threading.Thread(target=_update_memory_async, args=(text, ans), daemon=True).start()
            
        except Exception as e:
            print(f"[Ollama] Error: {e}")
            self.speak("I'm having trouble thinking right now, sir.")

    def run(self):
        import time
        self.is_running = True
        self.ui.set_state("LISTENING")
        self.ui.write_log("SYS: LESTER (Local) online.")
        
        # Start background voice listener
        self.voice.start_background_listening(self._process_input)
        
        while self.is_running:
            time.sleep(1)

def main():
    ui = LesterUI("face.png")

    def runner():
        ui.wait_for_api_key() # Still might need for some tools, or remove if fully offline
        lester = LesterLocal(ui)
        lester.run()

    threading.Thread(target=runner, daemon=True).start()
    ui.root.mainloop()

if __name__ == "__main__":
    main()
